    <!--  Default ToggleSwitch Style  -->
    <Style TargetType="CheckBox" x:Key="DefaultToggleSwitchStyle">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource OverlayBackgroundPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="1"
                            Height="24"
                            Width="44"
                            x:Name="SwitchTrack">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Path=(helpers:ScaleHelper.ScaleFactor), RelativeSource={RelativeSource TemplatedParent}}" ScaleY="{Binding Path=(helpers:ScaleHelper.ScaleFactor), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid.LayoutTransform>
                            <Border Background="{DynamicResource OverlayBackgroundSurfaceBrush}" CornerRadius="12" />

                            <Border
                                Background="{DynamicResource BackgroundAccentBrush}"
                                CornerRadius="12"
                                Opacity="0"
                                x:Name="ActiveTrack" />

                            <Grid
                                Height="20"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0"
                                Width="20"
                                x:Name="SwitchThumb">

                                <Ellipse Fill="{DynamicResource OverlaySelectionBrush}" Stroke="{x:Null}" />

                                <Grid.RenderTransform>
                                    <TranslateTransform X="0" x:Name="ThumbTranslate" />
                                </Grid.RenderTransform>
                            </Grid>
                        </Grid>

                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            RecognizesAccessKey="True"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">

                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="0">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="ActiveTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="ActiveTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Duration="0"
                                            Storyboard.TargetName="SwitchTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

