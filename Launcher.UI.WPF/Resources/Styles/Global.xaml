<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <helpers:EdgeAdornerConverter x:Key="EdgeConverter" />
    <helpers:ImagePathConverter x:Key="ImagePathConverter" />
    <!--  Footer navigation button style  -->
    <Style TargetType="RadioButton" x:Key="NavRadioButtonStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="{DynamicResource DefaultCorner}"
                        x:Name="PART_Border">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BackgroundAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundOnAccentBrush}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundNavBrush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Accent button style  -->
    <Style TargetType="Button" x:Key="AccentButtonStyle">
        <Setter Property="Background" Value="{DynamicResource BackgroundAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource SecondBorderThickness}" />
        <Setter Property="Padding" Value="10,0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource DefaultCorner}"
                        Padding="{TemplateBinding Padding}"
                        x:Name="PART_Border">

                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="SideColumns" Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" x:Name="RightCol" />
                            </Grid.ColumnDefinitions>

                            <Viewbox
                                Grid.Column="0"
                                Height="{Binding Path=(helpers:ButtonHelper.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                HorizontalAlignment="Center"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Width="{Binding Path=(helpers:ButtonHelper.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                x:Name="PART_Icon">

                                <Path
                                    Data="{TemplateBinding Tag}"
                                    Fill="Transparent"
                                    Stretch="Uniform"
                                    Stroke="{TemplateBinding Foreground}"
                                    StrokeThickness="1.33" />
                            </Viewbox>

                            <ContentPresenter
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                x:Name="ContentView" />

                            <Viewbox
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Height="{Binding Path=(helpers:ButtonHelper.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Width="{Binding Path=(helpers:ButtonHelper.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                x:Name="LoadingSpinner">

                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0" x:Name="SpinnerTransform" />
                                </Viewbox.RenderTransform>

                                <Grid Height="24" Width="24">
                                    <Ellipse
                                        Fill="Transparent"
                                        Height="24"
                                        Width="24" />

                                    <Path
                                        Data="M 12 2 A 10 10 0 1 1 2 12"
                                        Fill="Transparent"
                                        Stroke="{TemplateBinding Foreground}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2.5" />
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="helpers:ButtonHelper.BalanceText" Value="True">
                            <Setter Property="SharedSizeGroup" TargetName="RightCol" Value="SideColumns" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_Icon" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Grid.Column" TargetName="PART_Icon" Value="1" />
                            <Setter Property="Visibility" TargetName="ContentView" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="helpers:ButtonHelper.IsLoading" Value="True">
                            <Setter Property="Opacity" TargetName="PART_Icon" Value="0" />
                            <Setter Property="Opacity" TargetName="ContentView" Value="0" />

                            <Setter Property="Visibility" TargetName="LoadingSpinner" Value="Visible" />

                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SpinStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Duration="0:0:1"
                                            From="0"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="LoadingSpinner"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            To="360" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

