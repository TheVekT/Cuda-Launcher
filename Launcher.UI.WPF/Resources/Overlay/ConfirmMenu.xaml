<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=viewModels:ConfirmVM,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Resources.Overlay.ConfirmMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Launcher.UI.WPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="Auto" Width="384">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Viewbox
                            Height="24"
                            HorizontalAlignment="Left"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Width="24">
                            <Path
                                Data="{StaticResource Icon.Alert}"
                                Stroke="{DynamicResource AlertForegroundBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.33" />
                        </Viewbox>
                        <TextBlock
                            FontSize="15"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Text="{Binding Title}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        Margin="0,10"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <Border
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="0,0,0,0.1"
                        Height="1" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" />
                        <Button
                            Command="{Binding CancelCommand}"
                            Content="{Binding Source={StaticResource Loc}, Path=[CancelButtonText]}"
                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                            Grid.Column="1"
                            Height="35"
                            Style="{StaticResource DefaultButtonStyle}"
                            Tag="{StaticResource Icon.Close}"
                            helpers:ButtonHelper.IconSize="10" />
                        <Button
                            Command="{Binding ConfirmCommand}"
                            Content="{Binding Source={StaticResource Loc}, Path=[ConfirmButtonText]}"
                            Grid.Column="2"
                            Height="35"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Tag="{StaticResource Icon.Trash}"
                            helpers:ButtonHelper.IconSize="13" />
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>
        <Button
            Command="{Binding CancelCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12"
            x:Name="CloseMenuButton">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
