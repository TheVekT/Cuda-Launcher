<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Resources.Overlay.SettingsMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:local="clr-namespace:Launcher.UI.WPF.Resources.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StringFormatConverter x:Key="StringFormatConverter" />
    </UserControl.Resources>
    <Grid Style="{StaticResource DefaultOverlayGridStyle}">
        <Border
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                    Margin="0,0,0,5"
                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Title]}" />
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Subtitle]}" />
                <Border
                    Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                    CornerRadius="{DynamicResource DefaultCorner}"
                    HorizontalAlignment="Center"
                    Margin="0,10"
                    Padding="4"
                    VerticalAlignment="Top"
                    Width="472">

                    <helpers:FlexPanel>

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.General]}"
                            GroupName="SettingsTabs"
                            IsChecked="True"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabGeneral" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Java]}"
                            GroupName="SettingsTabs"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabJava" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Language]}"
                            GroupName="SettingsTabs"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabLanguage" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Theme]}"
                            GroupName="SettingsTabs"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabTheme" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.About]}"
                            GroupName="SettingsTabs"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabAbout" />

                    </helpers:FlexPanel>
                </Border>
                <!--  General Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabGeneral, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="GeneralSettingsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.KeepLauncherOpen]}"
                        FontSize="14"
                        Grid.Row="0"
                        IsChecked="False"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.EnableAutoUpdates]}"
                        FontSize="14"
                        Grid.Row="1"
                        IsChecked="True"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.EnableSnapshots]}"
                        FontSize="14"
                        Grid.Row="2"
                        IsChecked="False"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock FontSize="14" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Path="[SettingsMenu.General.InterfaceScaleLabel]" Source="{StaticResource Loc}" />

                                    <Binding ElementName="UiScaleSlider" Path="Value" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="120"
                            Minimum="80"
                            Style="{StaticResource DefaultSliderStyle}"
                            TickFrequency="1"
                            Value="100"
                            x:Name="UiScaleSlider" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.InterfaceScaleDescription]}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="4"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MinecraftRootDirectoryLabel]}" />
                        <Border
                            Background="{DynamicResource AlertBackgroundBrush}"
                            BorderBrush="{DynamicResource AlertBorderBrush}"
                            BorderThickness="{DynamicResource DefaultBorderThickness}"
                            CornerRadius="{DynamicResource DefaultCorner}"
                            Margin="0,5">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="{StaticResource Icon.Alert}"
                                        Fill="Transparent"
                                        Height="16"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource AlertForegroundBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.33"
                                        Width="16" />
                                </Viewbox>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource AlertForegroundBrush}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Margin="5"
                                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MinecraftRootDirectoryAlert]}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MoveMinecraftFolderButton]}"
                            FontSize="14"
                            Height="35"
                            Style="{StaticResource OverlayDefaultButtonStyle}"
                            Tag="{StaticResource Icon.Folder}" />
                    </StackPanel>
                </Grid>
                <!--  Java Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabJava, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="JavaSettingsPanel" />
                <!--  Language Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabLanguage, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="LanguageSettingsPanel" />
                <!--  Theme Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabTheme, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="ThemeSettingsPanel" />
                <!--  About Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabAbout, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="AboutSettingsPanel" />
            </StackPanel>
        </Border>
        <Button
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
