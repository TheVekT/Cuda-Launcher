<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Resources.Overlay.SettingsMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Launcher.UI.WPF.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:local="clr-namespace:Launcher.UI.WPF.Resources.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Launcher.UI.WPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <helpers:RadioBoolConverter x:Key="RadioBoolConverter" />
        <helpers:StringFormatConverter x:Key="StringFormatConverter" />
        <helpers:InvertBoolConverter x:Key="BoolToBool" />
    </UserControl.Resources>
    <Grid Width="512">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                    Margin="0,0,0,5"
                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Title]}" />
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Subtitle]}" />
                <Border
                    Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                    CornerRadius="{DynamicResource DefaultCorner}"
                    HorizontalAlignment="Center"
                    Margin="0,10"
                    Padding="4"
                    VerticalAlignment="Top"
                    Width="472">

                    <helpers:FlexPanel>

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.General]}"
                            GroupName="SettingsTabs"
                            IsChecked="False"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabGeneral" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Game]}"
                            GroupName="SettingsTabs"
                            IsChecked="False"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabGame" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Language]}"
                            GroupName="SettingsTabs"
                            IsChecked="False"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabLanguage" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.Theme]}"
                            GroupName="SettingsTabs"
                            IsChecked="True"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabTheme" />

                        <RadioButton
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Tabs.About]}"
                            GroupName="SettingsTabs"
                            Style="{StaticResource SegmentedTabButtonStyle}"
                            x:Name="TabAbout" />

                    </helpers:FlexPanel>
                </Border>
                <!--  General Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabGeneral, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="GeneralSettingsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.KeepLauncherOpen]}"
                        FontSize="14"
                        Grid.Row="0"
                        IsChecked="False"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.EnableAutoUpdates]}"
                        FontSize="14"
                        Grid.Row="1"
                        IsChecked="True"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <CheckBox
                        Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.DiscordRichPresence]}"
                        FontSize="14"
                        Grid.Row="2"
                        IsChecked="True"
                        Margin="0,5"
                        Style="{StaticResource DefaultToggleSwitchStyle}"
                        VerticalAlignment="Top"
                        helpers:ScaleHelper.ScaleFactor="0.8" />
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock FontSize="14" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Path="[SettingsMenu.General.InterfaceScaleLabel]" Source="{StaticResource Loc}" />

                                    <Binding ElementName="UiScaleSlider" Path="Value" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="120"
                            Minimum="80"
                            Style="{StaticResource DefaultSliderStyle}"
                            TickFrequency="1"
                            Value="{Binding UiScale, Converter={StaticResource PercentToScaleConverter}}"
                            x:Name="UiScaleSlider" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.InterfaceScaleDescription]}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="4"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MinecraftRootDirectoryLabel]}" />
                        <Border
                            Background="{DynamicResource AlertBackgroundBrush}"
                            BorderBrush="{DynamicResource AlertBorderBrush}"
                            BorderThickness="{DynamicResource DefaultBorderThickness}"
                            CornerRadius="{DynamicResource DefaultCorner}"
                            Margin="0,5">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="{StaticResource Icon.Alert}"
                                        Fill="Transparent"
                                        Height="16"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource AlertForegroundBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.33"
                                        Width="16" />
                                </Viewbox>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource AlertForegroundBrush}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Margin="5"
                                    Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MinecraftRootDirectoryAlert]}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.MoveMinecraftFolderButton]}"
                            FontSize="14"
                            Height="35"
                            Style="{StaticResource OverlayDefaultButtonStyle}"
                            Tag="{StaticResource Icon.Folder}" />
                    </StackPanel>
                </Grid>
                <!--  Game Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabGame, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="GameSettingsPanel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,5"
                            Orientation="Vertical">
                            <TextBlock FontSize="14" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                                <TextBlock FontSize="14" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                            <Binding Path="[SettingsMenu.Game.AllocatedMemoryLabel]" Source="{StaticResource Loc}" />

                                            <Binding ElementName="AllocatedMemory" Path="Value" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </TextBlock>
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="16384"
                                Minimum="1024"
                                Style="{StaticResource DefaultSliderStyle}"
                                TickFrequency="512"
                                Value="2048"
                                x:Name="AllocatedMemory" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <CheckBox
                                Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.EnableSnapshots]}"
                                FontSize="14"
                                Margin="0,5"
                                Style="{StaticResource DefaultToggleSwitchStyle}"
                                VerticalAlignment="Top"
                                helpers:ScaleHelper.ScaleFactor="0.8" />
                            <CheckBox
                                Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.General.FullscreenModeLabel]}"
                                FontSize="14"
                                Margin="0,5"
                                Style="{StaticResource DefaultToggleSwitchStyle}"
                                VerticalAlignment="Top"
                                helpers:ScaleHelper.ScaleFactor="0.8"
                                x:Name="FullscreenModeCheckbox" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            IsEnabled="{Binding IsChecked, ElementName=FullscreenModeCheckbox, Converter={StaticResource BoolToBool}}"
                            Margin="0,5"
                            Orientation="Vertical">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                Margin="0,0,0,5"
                                Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Game.WindowResolutionLabel]}" />
                            <ComboBox
                                Background="{DynamicResource OverlayButtonBackgroundBrush}"
                                Height="35"
                                SelectedIndex="0"
                                Style="{StaticResource DefaultComboBox}">
                                <ComboBoxItem Content="1920x1080" />
                                <ComboBoxItem Content="1600x900" />
                                <ComboBoxItem Content="1366x768" />
                                <ComboBoxItem Content="1280x720" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
                <!--  Language Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabLanguage, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="LanguageSettingsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Margin="0,0,0,5"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Language.SelectLanguageLabel]}" />
                        <ComboBox
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            Height="35"
                            SelectedIndex="0"
                            Style="{StaticResource DefaultComboBox}">
                            <ComboBoxItem Content="English (US)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Margin="0,0,0,5"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Language.UploadCustomLanguageLabel]}" />
                        <Button
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Language.UploadCustomLanguageButton]}"
                            FontSize="14"
                            Height="35"
                            Style="{StaticResource OverlayDefaultButtonStyle}"
                            Tag="{StaticResource Icon.Upload}" />
                    </StackPanel>
                </Grid>
                <!--  Theme Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabTheme, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="ThemeSettingsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Margin="0,0,0,5"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Theme.SelectThemeLabel]}" />
                        <ScrollViewer Style="{StaticResource HorizontalScrollViewerStyle}" helpers:ScrollViewerHelper.EnableHorizontalScrolling="True">
                            <StackPanel Orientation="Horizontal">

                                <RadioButton GroupName="Themes" Style="{StaticResource InvisibleRadioStyle}">

                                    <RadioButton.IsChecked>
                                        <Binding
                                            Converter="{StaticResource RadioBoolConverter}"
                                            ConverterParameter="/Assets/Themes/default-dark.xaml"
                                            Path="CurrentThemePath" />
                                    </RadioButton.IsChecked>

                                    <controls:ThemePreviewCard ThemeSource="/Assets/Themes/default-dark.xaml" />
                                </RadioButton>

                                <RadioButton GroupName="Themes" Style="{StaticResource InvisibleRadioStyle}">
                                    <RadioButton.IsChecked>
                                        <Binding
                                            Converter="{StaticResource RadioBoolConverter}"
                                            ConverterParameter="/Assets/Themes/default-light.xaml"
                                            Path="CurrentThemePath" />
                                    </RadioButton.IsChecked>
                                    <controls:ThemePreviewCard ThemeSource="/Assets/Themes/default-light.xaml" />
                                </RadioButton>

                                <RadioButton GroupName="Themes" Style="{StaticResource InvisibleRadioStyle}">
                                    <RadioButton.IsChecked>
                                        <Binding
                                            Converter="{StaticResource RadioBoolConverter}"
                                            ConverterParameter="/Assets/Themes/SteamPunk.xaml"
                                            Path="CurrentThemePath" />
                                    </RadioButton.IsChecked>
                                    <controls:ThemePreviewCard ThemeSource="/Assets/Themes/SteamPunk.xaml" />
                                </RadioButton>

                                <RadioButton GroupName="Themes" Style="{StaticResource InvisibleRadioStyle}">
                                    <RadioButton.IsChecked>
                                        <Binding
                                            Converter="{StaticResource RadioBoolConverter}"
                                            ConverterParameter="/Assets/Themes/CyberPunk.xaml"
                                            Path="CurrentThemePath" />
                                    </RadioButton.IsChecked>
                                    <controls:ThemePreviewCard ThemeSource="/Assets/Themes/CyberPunk.xaml" />
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,5"
                        Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Margin="0,0,0,5"
                            Text="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Theme.CustomizeAccentLabel]}" />
                        <Button
                            Content="{Binding Source={StaticResource Loc}, Path=[SettingsMenu.Theme.CustomizeAccentButton]}"
                            FontSize="14"
                            Height="35"
                            Style="{StaticResource OverlayDefaultButtonStyle}"
                            Tag="{StaticResource Icon.Upload}" />
                    </StackPanel>
                </Grid>
                <!--  About Settings Panel  -->
                <Grid Visibility="{Binding ElementName=TabAbout, Path=IsChecked, Converter={StaticResource BoolToVis}}" x:Name="AboutSettingsPanel" />
            </StackPanel>
        </Border>
        <Button
            Command="{Binding CloseOverlayCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12"
            x:Name="CloseMenuButton">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
