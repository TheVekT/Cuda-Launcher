<UserControl
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Resources.Overlay.Skeletons.AddVersionSkeleton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="512">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid x:Name="SkeletonUI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Border
                        Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                        CornerRadius="4"
                        Height="18"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,5"
                        Width="140" />
                    <Border
                        Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                        CornerRadius="4"
                        Height="14"
                        HorizontalAlignment="Left"
                        Width="220" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="14"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,5"
                            Width="80" />
                        <Border
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            CornerRadius="4"
                            Height="35" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,5">
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="14"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,5"
                            Width="100" />
                        <Border
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            CornerRadius="4"
                            Height="35"
                            Margin="0,0,0,5" />
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="14"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,0"
                            Width="120" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,5">
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="14"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,5"
                            Width="60" />
                        <Border
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            CornerRadius="4"
                            Height="35"
                            Margin="0,0,0,5" />
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="12"
                            HorizontalAlignment="Left"
                            Width="160" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,5">
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="3"
                            Height="14"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,5"
                            Width="110" />
                        <Border
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            CornerRadius="{DynamicResource DefaultCorner}"
                            Height="120"
                            Margin="0,0,0,5" />
                        <Border
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            CornerRadius="4"
                            Height="50" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Border
                        Background="{DynamicResource OverlayButtonBackgroundBrush}"
                        CornerRadius="4"
                        Height="30"
                        HorizontalAlignment="Right"
                        Width="75" />
                </Grid>
            </Grid>
        </Border>
        <Border
            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
            CornerRadius="6"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12" />
    </Grid>

</UserControl>
