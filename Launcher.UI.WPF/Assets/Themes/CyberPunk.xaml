<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:metadata="clr-namespace:Launcher.UI.WPF.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <metadata:ThemeMetadata
        Author="TheVekT"
        Description="Neon lights and high tech."
        Name="Cyberpunk"
        x:Key="ThemeInfo" />

    <FontFamily x:Key="GlobalFont">/Assets/Fonts/#Orbitron</FontFamily>

    <Color x:Key="AppBackground">#050505</Color>
    <Color x:Key="BackgroundSurface">#E60B0B15</Color>
    <Color x:Key="BackgroundTransparent">#99000000</Color>
    <Color x:Key="BackgroundLowTransparent">#101015</Color>

    <Color x:Key="BackgroundAccent">#FCEE0A</Color>

    <Color x:Key="OverlayButtonBackground">#1A00F0FF</Color>
    <Color x:Key="OverlayHoverButtonBg">#3300F0FF</Color>
    <Color x:Key="OverlayBackgroundPrimary">#080808</Color>
    <Color x:Key="OverlayBackgroundSurface">#15151A</Color>
    <Color x:Key="OverlaySelection">#00F0FF</Color>
    <Color x:Key="OverlayBorderPrimary">#333333</Color>

    <Color x:Key="HoverBackgroundNav">#2600F0FF</Color>
    <Color x:Key="HoverBackgroundDefaultBtn">#33FCEE0A</Color>
    <Color x:Key="ForegroundPrimary">#FFFFFF</Color>
    <Color x:Key="ForegroundSecondary">#00F0FF</Color>
    <Color x:Key="ForegroundPlaceholder">#6600F0FF</Color>
    <Color x:Key="ForegroundOnAccent">#000000</Color>
    <Color x:Key="BorderPrimary">#3300F0FF</Color>
    <Color x:Key="BorderSecondary">#6600F0FF</Color>
    <Color x:Key="BorderAccent">#FCEE0A</Color>
    <Color x:Key="InputBackground">#1A00F0FF</Color>
    <Color x:Key="DropDownArrow">#00F0FF</Color>

    <Color x:Key="AlertBorder">#FF003C</Color>
    <Color x:Key="AlertForeground">#FF003C</Color>
    <Color x:Key="AlertBackground">#26FF003C</Color>
    <Color x:Key="ColorDanger">#FF003C</Color>

    <CornerRadius x:Key="DefaultCorner">0</CornerRadius>
    <CornerRadius x:Key="NavButtonsCorner">0</CornerRadius>

    <Thickness x:Key="DefaultBorderThickness">1</Thickness>
    <Thickness x:Key="SecondBorderThickness">1</Thickness>

</ResourceDictionary>