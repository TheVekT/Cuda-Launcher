<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:metadata="clr-namespace:Launcher.UI.WPF.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <metadata:ThemeMetadata
        Author="TheVekT"
        Description="A steampunk themed design with warm, earthy tones and vintage aesthetics."
        Name="SteamPunk"
        x:Key="ThemeInfo" />
    <FontFamily x:Key="GlobalFont">Georgia</FontFamily>

    <Color x:Key="AppBackground">#2A1A0F</Color>
    <Color x:Key="BackgroundSurface">#904A3B2A</Color>
    <Color x:Key="BackgroundTransparent">#701A0F0A</Color>
    <Color x:Key="BackgroundLowTransparent">#3D2B1F</Color>
    <Color x:Key="BackgroundAccent">#C99A3C</Color>
    <Color x:Key="OverlayButtonBackground">#1AC99A3C</Color>
    <Color x:Key="OverlayHoverButtonBg">#33C99A3C</Color>
    <Color x:Key="OverlayBackgroundPrimary">#24160B</Color>
    <Color x:Key="OverlayBackgroundSurface">#3D2B1F</Color>
    <Color x:Key="OverlaySelection">#99EBE0C5</Color>
    <Color x:Key="OverlayBorderPrimary">#5C4033</Color>
    <Color x:Key="HoverBackgroundNav">#807A5A1F</Color>
    <Color x:Key="HoverBackgroundDefaultBtn">#80D2B48C</Color>

    <Color x:Key="ForegroundPrimary">#EBE0C5</Color>
    <Color x:Key="ForegroundSecondary">#99EBE0C5</Color>
    <Color x:Key="ForegroundPlaceholder">#66EBE0C5</Color>
    <Color x:Key="ForegroundOnAccent">#2A1A0F</Color>
    <Color x:Key="BorderPrimary">#877A5A1F</Color>
    <Color x:Key="BorderSecondary">#80B08D57</Color>
    <Color x:Key="BorderAccent">#C99A3C</Color>

    <Color x:Key="InputBackground">#33EBE0C5</Color>
    <Color x:Key="DropDownArrow">#B08D57</Color>

    <Color x:Key="AlertBackground">#40FF8C00</Color>
    <Color x:Key="AlertBorder">#B8860B</Color>
    <Color x:Key="AlertForeground">#FFD700</Color>
    <Color x:Key="ColorDanger">#ff4747</Color>
    <CornerRadius x:Key="DefaultCorner">3</CornerRadius>
    <CornerRadius x:Key="NavButtonsCorner">5</CornerRadius>
    <Thickness x:Key="DefaultBorderThickness">1</Thickness>
    <Thickness x:Key="SecondBorderThickness">0</Thickness>

</ResourceDictionary>
