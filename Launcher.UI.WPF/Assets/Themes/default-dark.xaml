<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:metadata="clr-namespace:Launcher.UI.WPF.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <metadata:ThemeMetaData
        Author="TheVekT"
        Description="Default dark theme."
        Name="Default Dark"
        x:Key="ThemeInfo" />

    <FontFamily x:Key="GlobalFont">Arial</FontFamily>

    <Color x:Key="AppBackground">#0A0A0A</Color>
    <Color x:Key="BackgroundSurface">#90171717</Color>
    <Color x:Key="BackgroundTransparent">#70000000</Color>
    <Color x:Key="BackgroundLowTransparent">#171717</Color>
    <Color x:Key="BackgroundAccent">#FFFFFF</Color>

    <Color x:Key="OverlayButtonBackground">#0DFFFFFF</Color>
    <Color x:Key="OverlayHoverButtonBg">#16FFFFFF</Color>
    <Color x:Key="OverlayBackgroundPrimary">#171717</Color>
    <Color x:Key="OverlayBackgroundSurface">#404040</Color>
    <Color x:Key="OverlaySelection">#A1A1A1</Color>
    <Color x:Key="OverlayBorderPrimary">#404040</Color>


    <Color x:Key="HoverBackgroundNav">#80171717</Color>
    <Color x:Key="HoverBackgroundDefaultBtn">#80303030</Color>

    <Color x:Key="ForegroundPrimary">#FFFFFF</Color>
    <Color x:Key="ForegroundSecondary">#99FFFFFF</Color>
    <Color x:Key="ForegroundPlaceholder">#66FFFFFF</Color>
    <Color x:Key="ForegroundOnAccent">#000000</Color>



    <Color x:Key="BorderPrimary">#87262626</Color>
    <Color x:Key="BorderSecondary">#80404040</Color>
    <Color x:Key="BorderAccent">#FFFFFF</Color>

    <Color x:Key="InputBackground">#1AFFFFFF</Color>

    <Color x:Key="AlertBorder">#807B3306</Color>
    <Color x:Key="AlertForeground">#FEE685</Color>
    <Color x:Key="AlertBackground">#33461901</Color>
    <Color x:Key="FeaturedForeground">#FFD02B</Color>
    <Color x:Key="ColorDanger">#FF6467</Color>
    <Color x:Key="DropDownArrow">#50717182</Color>

    <CornerRadius x:Key="DefaultCorner">6</CornerRadius>
    <CornerRadius x:Key="NavButtonsCorner">20</CornerRadius>
    <Thickness x:Key="DefaultBorderThickness">1</Thickness>
    <Thickness x:Key="SecondBorderThickness">0</Thickness>


</ResourceDictionary>