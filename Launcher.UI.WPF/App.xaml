<Application
    x:Class="Launcher.UI.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:local="clr-namespace:Launcher.UI.WPF"
    xmlns:services="clr-namespace:Launcher.UI.WPF.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--  Theme (можно заменить на runtime)  -->
                <ResourceDictionary Source="Assets/Themes/default-dark.xaml" x:Name="Theme" />

                <!--  Core styles (логика стилей, использует brushes из Theme)  -->
                <ResourceDictionary Source="Resources/Styles/Global.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Slider.xaml" />
                <ResourceDictionary Source="Resources/Styles/ThemePreviewStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:PercentToScaleConverter x:Key="PercentToScaleConverter" />
            <services:LocalizationService x:Key="Loc" />
        </ResourceDictionary>
    </Application.Resources>
</Application>