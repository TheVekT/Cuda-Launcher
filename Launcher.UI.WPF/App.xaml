<Application
    x:Class="Launcher.UI.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:customization="clr-namespace:Launcher.UI.WPF.Services.Customization"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Resources/Styles/Theme.Default.xaml" />
                <ResourceDictionary Source="Resources/Styles/Global.xaml" />
                <ResourceDictionary Source="Resources/Styles/Brushes.xaml" />


            </ResourceDictionary.MergedDictionaries>
            <helpers:ImagePathConverter x:Key="ImagePathConverter" />
            <helpers:EqualConverter x:Key="EqualConverter" />
            <helpers:EqualConverter x:Key="NotEqualConverter" Invert="True" />
            <x:Static Member="customization:LocalizationService.Instance" x:Key="Loc" />
            <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:PercentToScaleConverter x:Key="PercentToScaleConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>