<Application
    StartupUri="MainWindow.xaml"
    x:Class="Launcher.UI.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Launcher.UI.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--  Theme (можно заменить на runtime)  -->
                <ResourceDictionary Source="Assets/Themes/Default-Dark/Theme.xaml" />

                <!--  Core styles (логика стилей, использует brushes из Theme)  -->
                <ResourceDictionary Source="Resources/Styles/Global.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Brushes.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>