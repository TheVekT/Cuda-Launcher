<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=config:CustomizationViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Config.CustomizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:config="clr-namespace:Launcher.UI.WPF.ViewModels.Config"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Launcher.UI.WPF.ViewModels.Settings"
    xmlns:viewModels="clr-namespace:Launcher.UI.WPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Height="Auto"
        MaxWidth="512"
        Width="Auto">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid />
        </Border>
        <Button
            Command="{Binding SelfCloseCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12"
            x:Name="CloseMenuButton">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
