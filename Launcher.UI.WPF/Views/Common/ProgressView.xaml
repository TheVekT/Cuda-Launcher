<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Common.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Height="Auto" Width="386">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid>
                <StackPanel Orientation="Vertical">

                    <Border Padding="30,0">
                        <TextBlock
                            FontSize="15"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5"
                            Text="{Binding Title}"
                            TextAlignment="Center" />
                    </Border>

                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,20"
                        Text="{Binding Message}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Grid Height="6">
                        <Border
                            Background="White"
                            CornerRadius="3"
                            x:Name="ProgressMask" />

                        <ProgressBar
                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                            BorderThickness="0"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            IsIndeterminate="{Binding IsIndeterminate}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressValue}">

                            <ProgressBar.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=ProgressMask}" />
                            </ProgressBar.OpacityMask>
                        </ProgressBar>
                    </Grid>

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundPlaceholderBrush}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Text="{Binding ProgressText}"
                        Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />

                    <Button
                        Command="{Binding CancelCommand}"
                        Content="{helpers:Loc ProgressMenu_CancelButton}"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        Height="35"
                        Margin="0,15,0,0"
                        Style="{StaticResource DefaultButtonStyle}"
                        Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Button
            Command="{Binding HideCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>