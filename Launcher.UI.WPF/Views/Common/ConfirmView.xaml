<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=common:ConfirmViewModel,
                                     IsDesignTimeCreatable=False}"
    helpers:ConfirmViewHelper.VisibleButtons="{Binding Buttons}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Common.ConfirmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:common="clr-namespace:Launcher.UI.WPF.ViewModels.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Launcher.UI.WPF.Helpers.Enums"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:localization="clr-namespace:Launcher.UI.WPF.Helpers.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <helpers:ConfirmButtonVisibilityConverter x:Key="ButtonVisConverter" />
    </UserControl.Resources>
    <Grid
        Height="Auto"
        MaxWidth="512"
        Width="Auto">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <Border Padding="30,0">
                        <TextBlock
                            FontSize="15"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5"
                            Text="{Binding Title}"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,10"
                        Text="{Binding Message}"
                        TextAlignment="Center"
                        TextWrapping="NoWrap" />
                    <Border
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="0,0,0,0.1"
                        Height="1" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Command="{Binding CancelCommand}"
                            Content="{localization:Loc Confirmation_CancelButtonText}"
                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                            Grid.Column="0"
                            Height="35"
                            Style="{StaticResource DefaultButtonStyle}"
                            Tag="{StaticResource Icon.Close}"
                            helpers:ButtonHelper.IconSize="10" />
                        <Button
                            Background="{DynamicResource DangerForegroundBrush}"
                            Command="{Binding ConfirmCommand}"
                            Content="{localization:Loc Confirmation_DeleteButtonText}"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Grid.Column="1"
                            Height="35"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Tag="{StaticResource Icon.Trash}"
                            Visibility="{Binding Path=(helpers:ConfirmViewHelper.VisibleButtons), RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ButtonVisConverter}, ConverterParameter={x:Static enums:ConfirmButtons.Delete}}"
                            helpers:ButtonHelper.IconSize="13"
                            x:Name="DeleteButton" />
                        <Button
                            Command="{Binding ConfirmCommand}"
                            Content="{localization:Loc Confirmation_ConfirmButtonText}"
                            Grid.Column="1"
                            Height="35"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Tag="{StaticResource Icon.Accept}"
                            Visibility="{Binding Path=(helpers:ConfirmViewHelper.VisibleButtons), RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ButtonVisConverter}, ConverterParameter={x:Static enums:ConfirmButtons.Confirm}}"
                            helpers:ButtonHelper.IconSize="13"
                            x:Name="ConfirmButton" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Background="{DynamicResource AlertBackgroundBrush}"
            CornerRadius="{DynamicResource SecondaryCorner}"
            HorizontalAlignment="Left"
            Margin="12,12,0,0"
            VerticalAlignment="Top">
            <Viewbox
                Height="24"
                HorizontalAlignment="Center"
                Margin="5"
                VerticalAlignment="Center"
                Width="24">
                <Path
                    Data="{StaticResource Icon.Alert}"
                    HorizontalAlignment="Center"
                    Stroke="{DynamicResource AlertForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.33"
                    VerticalAlignment="Center" />
            </Viewbox>
        </Border>
        <Button
            Command="{Binding CancelCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12"
            x:Name="CloseMenuButton">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
