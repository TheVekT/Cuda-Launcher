<UserControl
    Margin="0,0,0,10"
    Width="400"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Common.Notifications.WarnNotify"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Name="FadeOutStoryboard_Loaded">
                <Storyboard>
                    <DoubleAnimation
                        BeginTime="0:0:5"
                        Completed="FadeOut_Completed"
                        Duration="0:0:1"
                        From="1"
                        Storyboard.TargetProperty="Opacity"
                        To="0" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseEnter">
            <StopStoryboard BeginStoryboardName="FadeOutStoryboard_Loaded" />
            <StopStoryboard BeginStoryboardName="FadeOutStoryboard_Leave" />
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Duration="0:0:0.2"
                        Storyboard.TargetProperty="Opacity"
                        To="1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard Name="FadeOutStoryboard_Leave">
                <Storyboard>
                    <DoubleAnimation
                        BeginTime="0:0:5"
                        Completed="FadeOut_Completed"
                        Duration="0:0:1"
                        From="1"
                        Storyboard.TargetProperty="Opacity"
                        To="0" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>

        <Border Background="{DynamicResource BackgroundLowTransparentBrush}" CornerRadius="{DynamicResource DefaultCorner}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Color="Black"
                    Opacity="0.4"
                    RenderingBias="Quality"
                    ShadowDepth="4" />
            </Border.Effect>
        </Border>

        <Border
            Background="{DynamicResource BackgroundLowTransparentBrush}"
            BorderBrush="{DynamicResource BorderSecondaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{DynamicResource AlertForegroundBrush}"
                    CornerRadius="16"
                    Grid.Column="0"
                    Height="20"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top"
                    Width="20">
                    <Path
                        Data="{StaticResource Icon.Alert}"
                        Height="13"
                        HorizontalAlignment="Center"
                        Stretch="Uniform"
                        Stroke="{DynamicResource BackgroundLowTransparentBrush}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.33"
                        VerticalAlignment="Center"
                        Width="13" />
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock
                        FontFamily="{DynamicResource GlobalFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Margin="0,0,0,4"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="{DynamicResource GlobalFont}"
                        FontSize="12"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    Grid.Column="2"
                    Height="10"
                    HorizontalAlignment="Right"
                    Margin="4,0,0,0"
                    VerticalAlignment="Top"
                    Width="10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Stretch="Uniform">
                        <Path
                            Data="{StaticResource Icon.Close}"
                            Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                            StrokeThickness="2" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>

</UserControl>