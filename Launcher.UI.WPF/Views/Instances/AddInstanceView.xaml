<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=instances:AddInstanceViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Instances.AddInstanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:Launcher.UI.WPF.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:instances="clr-namespace:Launcher.UI.WPF.ViewModels.Instances"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skeletons="clr-namespace:Launcher.UI.WPF.Views.Instances.Skeletons"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <helpers:StringFormatConverter x:Key="StringFormatConverter" />
        <DataTemplate x:Key="MenuTemplate">
            <Grid Width="512">
                <Border
                    Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
                    BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
                    BorderThickness="{DynamicResource DefaultBorderThickness}"
                    CornerRadius="{DynamicResource DefaultCorner}"
                    Padding="20">
                    <Grid>

                        <Grid Visibility="{Binding CreatingPage1Visible, Converter={StaticResource BoolToVis}}">
                            <!-- <Grid Visibility="Collapsed"> -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                    Margin="0,0,0,5"
                                    Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.Title]}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.Subtitle]}" />
                            </StackPanel>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                Style="{StaticResource MinimalScrollViewer}"
                                VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.ModLoaderLabel]}" />
                                        <ComboBox
                                            Height="35"
                                            ItemContainerStyle="{StaticResource ImageComboBoxItemStyle}"
                                            ItemTemplate="{StaticResource ImageComboBoxItemTemplate}"
                                            ItemsSource="{Binding AvailableLoaders}"
                                            Margin="0,5,0,0"
                                            SelectedItem="{Binding SelectedModLoader}"
                                            Style="{StaticResource LoaderComboBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,5">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.GameVersionLabel]}" />
                                        <ComboBox
                                            Height="35"
                                            ItemsSource="{Binding GameVersions}"
                                            Margin="0,5,0,0"
                                            MaxDropDownHeight="265"
                                            SelectedItem="{Binding SelectedGameVersion}"
                                            Style="{StaticResource OverlayComboBox}"
                                            x:Name="SelectVersionComboBox" />
                                        <Expander
                                            FontSize="12"
                                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                            Header="{Binding Source={StaticResource Loc}, Path=[AddInstallation.LoaderVersionLabel]}"
                                            Margin="0,5,0,0">
                                            <Expander.Style>
                                                <Style BasedOn="{StaticResource MoreContentExpanderStyle}" TargetType="Expander">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedModLoader.Name}" Value="Vanilla">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <ComboBox
                                                Height="35"
                                                ItemsSource="{Binding LoaderVersions}"
                                                Margin="0,5,0,0"
                                                MaxDropDownHeight="230"
                                                SelectedItem="{Binding SelectedLoaderVersion}"
                                                Style="{StaticResource OverlayComboBox}" />
                                        </Expander>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,5">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.NameLabel]}" />
                                        <TextBox
                                            FontSize="12"
                                            Height="35"
                                            Margin="0,5,0,0"
                                            Style="{StaticResource DefaultTextInputStyle}"
                                            Tag="{Binding SuggestedName}"
                                            Text="{Binding InstallationName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Background="Transparent"
                                            FontSize="11"
                                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                            Margin="0,5,0,0"
                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.NamePlaceholder]}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,5">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.InstallationIconLabel]}" />

                                        <Border
                                            Background="{DynamicResource OverlayBackgroundSurfaceBrush}"
                                            CornerRadius="{DynamicResource DefaultCorner}"
                                            Margin="0,5,0,0"
                                            MaxHeight="120"
                                            Padding="5">

                                            <ListBox
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemsSource="{Binding InstancesStore.IconList}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                SelectedItem="{Binding SelectedIcon}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="8" VerticalAlignment="Top" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="{DynamicResource DefaultCorner}">
                                                            <Image
                                                                Height="40"
                                                                HorizontalAlignment="Center"
                                                                Stretch="Uniform"
                                                                VerticalAlignment="Center"
                                                                Width="40"
                                                                gif:ImageBehavior.AnimatedSource="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="2" />
                                                        <Setter Property="Margin" Value="2" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource DefaultCorner}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        x:Name="Bd">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource BorderAccentBrush}" />
                                                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource OverlayHoverButtonBgBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource OverlayHoverButtonBgBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>


                                        <!--  Click="UploadButton_Click"  -->
                                        <!--  DragEnter="UploadButton_DragEnter"  -->
                                        <!--  Drop="UploadButton_Drop"  -->
                                        <Button
                                            Command="{Binding SelectIconCommand}"
                                            Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.InstallationIconUpload]}"
                                            Height="50"
                                            Margin="0,5,0,0"
                                            Style="{StaticResource UploadDropZoneStyle}"
                                            behaviors:FileDragDropBehavior.DropCommand="{Binding DropIconCommand}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" />
                                <Button
                                    Command="{Binding ToggleCreatingPageCommand}"
                                    FlowDirection="RightToLeft"
                                    FontSize="13"
                                    Grid.Column="1"
                                    Height="30"
                                    IsDefault="True"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="75"
                                    Tag="{DynamicResource Icon.ArrowLeft}"
                                    helpers:ButtonHelper.IconSize="11"
                                    x:Name="NextButton">
                                    <Button.Content>
                                        <TextBlock FlowDirection="LeftToRight" Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.NextButton]}" />
                                    </Button.Content>
                                </Button>

                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding CreatingPage2Visible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                    Margin="0,0,0,5"
                                    Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.ConfigureInstallationTitle]}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.ConfigureInstallationSubtitle]}" />
                            </StackPanel>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                Style="{StaticResource MinimalScrollViewer}"
                                VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Background="{DynamicResource OverlayButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
                                        BorderThickness="{DynamicResource DefaultBorderThickness}"
                                        CornerRadius="{DynamicResource DefaultCorner}"
                                        Grid.Row="0"
                                        Margin="0,10,0,0"
                                        Padding="10,15">
                                        <StackPanel Orientation="Vertical">

                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.IsolationTitle]}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                Margin="0,5,0,5"
                                                Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.IsolationDescription]}" />
                                            <RadioButton
                                                Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionNoIsolation]}"
                                                GroupName="IsolationGroup"
                                                IsChecked="{Binding SelectedIsolation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Global}"
                                                Margin="0,10,0,0"
                                                Tag="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionNoIsolationDesc]}">
                                                <RadioButton.Style>
                                                    <Style BasedOn="{StaticResource PointOptionRadioStyle}" TargetType="RadioButton">
                                                        <Setter Property="helpers:RadioButtonHelper.RecommendedBadgeText" Value="{x:Null}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedModLoader.Name}" Value="Vanilla">
                                                                <Setter Property="helpers:RadioButtonHelper.RecommendedBadgeText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.RecommendedBadge]}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <Grid
                                                Margin="0,10,0,0"
                                                Style="{StaticResource AnimatedVisibilityStyle}"
                                                helpers:VisibilityHelper.IsVisible="{Binding SelectedModLoader, Converter={StaticResource NotEqualConverter}, ConverterParameter=Vanilla}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton
                                                    Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionPartialIsolation]}"
                                                    Grid.Column="0"
                                                    GroupName="IsolationGroup"
                                                    IsChecked="{Binding SelectedIsolation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Partial}"
                                                    Style="{StaticResource PointOptionRadioStyle}"
                                                    Tag="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionPartialIsolationDesc]}" />
                                                <Border
                                                    Background="{DynamicResource AlertBackgroundBrush}"
                                                    BorderBrush="{DynamicResource AlertBorderBrush}"
                                                    BorderThickness="{DynamicResource DefaultBorderThickness}"
                                                    CornerRadius="{DynamicResource DefaultCorner}"
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="8"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox
                                                            Height="18"
                                                            VerticalAlignment="Center"
                                                            Width="18">
                                                            <Path
                                                                Data="{StaticResource Icon.Alert}"
                                                                Stroke="{DynamicResource AlertForegroundBrush}"
                                                                StrokeEndLineCap="Round"
                                                                StrokeStartLineCap="Round"
                                                                StrokeThickness="1.33" />
                                                        </Viewbox>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource AlertForegroundBrush}"
                                                            Margin="10,0,0,0"
                                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.UAC.AlertLabel]}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                            </Grid>
                                            <RadioButton
                                                Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionFullIsolation]}"
                                                GroupName="IsolationGroup"
                                                IsChecked="{Binding SelectedIsolation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Full}"
                                                Margin="0,10,0,0"
                                                Tag="{Binding Source={StaticResource Loc}, Path=[AddInstallation.OptionFullIsolationDesc]}">
                                                <RadioButton.Style>
                                                    <Style BasedOn="{StaticResource PointOptionRadioStyle}" TargetType="RadioButton">
                                                        <Setter Property="helpers:RadioButtonHelper.RecommendedBadgeText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.RecommendedBadge]}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedModLoader.Name}" Value="Vanilla">
                                                                <Setter Property="helpers:RadioButtonHelper.RecommendedBadgeText" Value="{x:Null}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="1">
                                        <CheckBox
                                            FontSize="14"
                                            IsChecked="{Binding InstallPerformanceMods}"
                                            Margin="0,10,0,5"
                                            Style="{StaticResource DefaultToggleSwitchStyle}"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding IrisAndSodiumVisible, Converter={StaticResource BoolToVis}}"
                                            helpers:ScaleHelper.ScaleFactor="0.8">

                                            <CheckBox.Content>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource ForegroundPrimaryBrush}" Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.AutoInstallIrisSodiumLabel]}" />
                                                </StackPanel>
                                            </CheckBox.Content>
                                        </CheckBox>
                                        <Expander
                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                            Header="{Binding Source={StaticResource Loc}, Path=[AddInstallation.MoreOptionsLabel]}"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource MoreContentExpanderStyle}">

                                            <StackPanel Orientation="Vertical">
                                                <CheckBox
                                                    Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.InheritGameSettings]}"
                                                    FontSize="13"
                                                    IsChecked="{Binding UseGlobalGameSettings}"
                                                    Margin="0,5,0,0"
                                                    Style="{StaticResource DefaultToggleSwitchStyle}"
                                                    VerticalAlignment="Top"
                                                    helpers:ScaleHelper.ScaleFactor="0.8"
                                                    x:Name="InheritGameSettings" />
                                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=InheritGameSettings, Converter={StaticResource EqualConverter}, ConverterParameter=False}" Orientation="Vertical">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="IsEnabled" Value="{Binding IsChecked, ElementName=EnableBackupInherit, Converter={StaticResource EqualConverter}, ConverterParameter=False}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <StackPanel Orientation="Vertical">
                                                        <StackPanel Margin="0,5" Orientation="Vertical">
                                                            <TextBlock FontSize="13" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                                                                <TextBlock FontSize="13" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                                                            <Binding Path="[AddInstallation.AllocatedMemoryLabel]" Source="{StaticResource Loc}" />

                                                                            <Binding ElementName="AllocatedMemory" Path="Value" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </TextBlock>
                                                            <Slider
                                                                IsSnapToTickEnabled="True"
                                                                Maximum="{Binding SettingsStore.MaxPhysicalRam}"
                                                                Minimum="1024"
                                                                Style="{StaticResource DefaultSliderStyle}"
                                                                TickFrequency="512"
                                                                Value="{Binding SelectedMaxRam}"
                                                                x:Name="AllocatedMemory" />
                                                        </StackPanel>
                                                        <CheckBox
                                                            Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.FullscreenModeLabel]}"
                                                            FontSize="13"
                                                            IsChecked="{Binding IsGameFullscreen}"
                                                            Margin="0,5,0,0"
                                                            Style="{StaticResource DefaultToggleSwitchStyle}"
                                                            VerticalAlignment="Top"
                                                            helpers:ScaleHelper.ScaleFactor="0.8"
                                                            x:Name="FullscreenModeCheckbox" />
                                                        <StackPanel
                                                            Margin="0,5"
                                                            Orientation="Vertical"
                                                            Style="{StaticResource AnimatedVisibilityStyle}"
                                                            helpers:VisibilityHelper.IsVisible="{Binding Path=IsChecked, ElementName=FullscreenModeCheckbox, Converter={StaticResource EqualConverter}, ConverterParameter=False}">
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                                Margin="0,0,0,5"
                                                                Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.WindowResolutionLabel]}" />
                                                            <ComboBox
                                                                Height="30"
                                                                ItemsSource="{Binding SettingsStore.AvailableResolutions}"
                                                                SelectedItem="{Binding SelectedResolution}"
                                                                Style="{StaticResource OverlayComboBox}">

                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" x:Name="ResolutionText" />

                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="Auto">
                                                                                <Setter Property="Text" TargetName="ResolutionText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.Resolution.Auto]}" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                            Margin="0,5,0,0"
                                                            Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.EditJVMArgumentsLabel]}"
                                                            TextWrapping="Wrap" />
                                                        <TextBox
                                                            FontSize="12"
                                                            Margin="0,5"
                                                            Style="{StaticResource DefaultTextInputStyle}"
                                                            Tag="JVM Arguments"
                                                            Text="{Binding JVMArguments}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical">
                                                    <CheckBox
                                                        Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.InheritBackupSettings]}"
                                                        FontSize="13"
                                                        IsChecked="{Binding UseGlobalBackupSettings}"
                                                        Margin="0,5"
                                                        Style="{StaticResource DefaultToggleSwitchStyle}"
                                                        VerticalAlignment="Top"
                                                        helpers:ScaleHelper.ScaleFactor="0.8"
                                                        x:Name="EnableBackupInherit" />

                                                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=EnableBackupInherit, Converter={StaticResource EqualConverter}, ConverterParameter=False}" Orientation="Vertical">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="IsEnabled" Value="{Binding IsChecked, ElementName=EnableBackupInherit, Converter={StaticResource EqualConverter}, ConverterParameter=False}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Border Padding="0,5">
                                                            <StackPanel>
                                                                <CheckBox
                                                                    Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.EnableBackups]}"
                                                                    FontSize="12"
                                                                    IsChecked="{Binding IsEnableAutoBackups}"
                                                                    Margin="0,0,0,5"
                                                                    Style="{StaticResource DefaultToggleSwitchStyle}"
                                                                    VerticalAlignment="Top"
                                                                    helpers:ScaleHelper.ScaleFactor="0.8"
                                                                    x:Name="EnableBackupsCheckbox" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                                    Margin="0,0,0,6"
                                                                    Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupFreqLabel]}" />
                                                                <ComboBox
                                                                    Height="30"
                                                                    ItemsSource="{Binding SettingsStore.BackupFrequencyValues}"
                                                                    SelectedItem="{Binding SelectedBackupFrequency}"
                                                                    Style="{StaticResource OverlayComboBox}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock x:Name="FreqText" />
                                                                            <DataTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding}" Value="Daily">
                                                                                    <Setter Property="Text" TargetName="FreqText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupFreq.Daily]}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="Weekly">
                                                                                    <Setter Property="Text" TargetName="FreqText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupFreq.Weekly]}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="Biweekly">
                                                                                    <Setter Property="Text" TargetName="FreqText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupFreq.Biweekly]}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="Monthly">
                                                                                    <Setter Property="Text" TargetName="FreqText" Value="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupFreq.Monthly]}" />
                                                                                </DataTrigger>
                                                                            </DataTemplate.Triggers>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                                        Margin="0,0,10,0"
                                                                        Text="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackupsLimitLabel]}"
                                                                        VerticalAlignment="Center" />
                                                                    <TextBox
                                                                        Background="Transparent"
                                                                        FontSize="12"
                                                                        MaxLength="1"
                                                                        Padding="4"
                                                                        Style="{StaticResource DefaultTextInputStyle}"
                                                                        Text="{Binding MaxBackupCount}"
                                                                        TextAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Width="25"
                                                                        behaviors:NumericTextBoxBehavior.IsEnabled="True" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Command="{Binding ToggleCreatingPageCommand}"
                                    Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.BackButton]}"
                                    FontSize="13"
                                    Grid.Column="0"
                                    Height="30"
                                    Style="{StaticResource OverlayDefaultButtonStyle}"
                                    Width="75"
                                    Tag="{DynamicResource Icon.ArrowLeft}"
                                    helpers:ButtonHelper.IconSize="11"
                                    x:Name="BackButton">
                                </Button>
                                <Button
                                    Command="{Binding CreateInstanceCommand}"
                                    Content="{Binding Source={StaticResource Loc}, Path=[AddInstallation.CreateButton]}"
                                    FontSize="13"
                                    Grid.Column="1"
                                    Height="30"
                                    IsDefault="True"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{DynamicResource Icon.AddIcon}"
                                    helpers:ButtonHelper.BalanceText="True"
                                    helpers:ButtonHelper.IconSize="13"
                                    helpers:ButtonHelper.IsLoading="{Binding IsCreatingInstance}" />
                            </Grid>
                        </Grid>


                    </Grid>
                </Border>
                <Button
                    Command="{Binding CloseSelfCommand}"
                    Cursor="Hand"
                    Height="12"
                    HorizontalAlignment="Right"
                    Margin="0,20,20,0"
                    VerticalAlignment="Top"
                    Width="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Stretch="Uniform">
                        <Path
                            Data="{DynamicResource Icon.Close}"
                            Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                            StrokeThickness="1.33" />
                    </Viewbox>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <skeletons:AddInstanceSkeleton Visibility="{Binding IsViewReady, Converter={StaticResource InverseBoolToVis}}" />

        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsViewReady}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource MenuTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>