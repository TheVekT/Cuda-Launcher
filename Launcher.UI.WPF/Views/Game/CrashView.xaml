<UserControl
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    d:DataContext="{d:DesignInstance Type=game:CrashViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.Views.Game.CrashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:game="clr-namespace:Launcher.UI.WPF.ViewModels.Game"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:localization="clr-namespace:Launcher.UI.WPF.Helpers.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="512">
        <Border
            Background="{DynamicResource OverlayBackgroundPrimaryBrush}"
            BorderBrush="{DynamicResource OverlayBorderPrimaryBrush}"
            BorderThickness="{DynamicResource DefaultBorderThickness}"
            CornerRadius="{DynamicResource DefaultCorner}"
            Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <Border
                        CornerRadius="{DynamicResource DefaultCorner}"
                        Height="32"
                        Padding="5"
                        VerticalAlignment="Center"
                        Width="32">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource ColorDanger}" Opacity="0.2" />
                        </Border.Background>
                        <Path
                            Data="{StaticResource Icon.XCircle}"
                            Stretch="Uniform"
                            Stroke="{DynamicResource DangerForegroundBrush}"
                            StrokeThickness="1.33" />
                    </Border>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Margin="10,0,0,0"
                        Text="{localization:Loc CrashReportView_Title}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Text="{localization:Loc CrashReportView_ExitCode}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Margin="5,0,0,0"
                        Text="{Binding ExitCode}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    Orientation="Vertical">
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Margin="0,0,0,8"
                        Text="{localization:Loc CrashReportView_StackTrace}"
                        VerticalAlignment="Center" />
                    <Border
                        Background="{DynamicResource BackgroundTransparentBrush}"
                        BorderBrush="{DynamicResource BorderSecondaryBrush}"
                        BorderThickness="{DynamicResource DefaultBorderThickness}"
                        CornerRadius="{DynamicResource DefaultCorner}"
                        Padding="5">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            MaxHeight="300"
                            Style="{StaticResource MinimalScrollViewer}"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                Text="{Binding StackTrace}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CrashReportFile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Visible" />
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Text="{localization:Loc CrashReportView_FromFile}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        Margin="5,0,0,0"
                        Text="{Binding CrashReportFile}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" />
                    <Button
                        Command="{Binding CopyStackTraceCommand}"
                        Content="{localization:Loc CrashReportView_CopyError}"
                        FontSize="13"
                        Grid.Column="1"
                        Height="30"
                        IsDefault="True"
                        Style="{StaticResource DefaultButtonStyle}"
                        Tag="{StaticResource Icon.Copy}"
                        helpers:ButtonHelper.IconSize="12" />
                    <Button
                        Command="{Binding CloseSelfCommand}"
                        Content="{localization:Loc CrashReportView_Close}"
                        FontSize="13"
                        Grid.Column="2"
                        Height="30"
                        IsDefault="True"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}" />

                </Grid>
            </Grid>
        </Border>
        <Button
            Command="{Binding CloseSelfCommand}"
            Cursor="Hand"
            Height="12"
            HorizontalAlignment="Right"
            Margin="0,20,20,0"
            VerticalAlignment="Top"
            Width="12">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Stretch="Uniform">
                <Path
                    Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource ForegroundPlaceholderBrush}"
                    StrokeThickness="1.33" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
