<Window
    Background="{DynamicResource AppBackgroundBrush}"
    FontFamily="{DynamicResource GlobalFont}"
    FontWeight="Medium"
    Height="720"
    Margin="0"
    MinHeight="720"
    MinWidth="1280"
    TextOptions.TextFormattingMode="Display"
    Title="{Binding Source={StaticResource Loc}, Path=[MainWindow.Title]}"
    UseLayoutRounding="True"
    Width="1280"
    WindowStyle="SingleBorderWindow"
    d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:accounts="clr-namespace:Launcher.UI.WPF.ViewModels.Accounts"
    xmlns:behaviors="clr-namespace:Launcher.UI.WPF.Behaviors"
    xmlns:controls="clr-namespace:Launcher.UI.WPF.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Launcher.Core.Enums;assembly=Launcher.Core"
    xmlns:game="clr-namespace:Launcher.UI.WPF.ViewModels.Game"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:instances="clr-namespace:Launcher.UI.WPF.ViewModels.Instances"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menus="clr-namespace:Launcher.UI.WPF.Resources.Overlay.Menus"
    xmlns:notifications="clr-namespace:Launcher.UI.WPF.Resources.Overlay.Notifications"
    xmlns:pages="clr-namespace:Launcher.UI.WPF.Resources.Pages"
    xmlns:settings="clr-namespace:Launcher.UI.WPF.ViewModels.Settings"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:viewModels="clr-namespace:Launcher.UI.WPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <helpers:StringToResourceConverter x:Key="StringToResourceConverter" />

        <DataTemplate DataType="{x:Type game:PlayViewModel}">
            <pages:Play />
        </DataTemplate>

        <DataTemplate DataType="{x:Type instances:InstallationsViewModel}">
            <pages:Installations />
        </DataTemplate>

        <DataTemplate DataType="{x:Type game:SkinsViewModel}">
            <pages:Skins />
        </DataTemplate>

        <DataTemplate DataType="{x:Type instances:InstanceCreationVM}">
            <menus:AddVersionMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type instances:InstanceSettingsVM}">
            <menus:VersionSettingsMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:ConfirmVM}">
            <menus:ConfirmMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:CustomizationSettingsVM}">
            <menus:CustomizationSettingsMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:ProgressVM}">
            <menus:ProgressMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type accounts:LoginVM}">
            <menus:LoginMenu />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:SettingsVM}">
            <menus:SettingsMenu />
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="1"
            CornerRadius="{DynamicResource DefaultCorner}"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:CustomTitleBar Grid.Row="0" />
        <Grid
            AllowDrop="{Binding AppStore.IsOverlayVisible, Converter={StaticResource NotEqualConverter}, ConverterParameter=True}"
            Grid.Row="1"
            behaviors:FileDragDropBehavior.DragEnterCommand="{Binding DragEnterCommand}"
            behaviors:FileDragDropBehavior.DragLeaveCommand="{Binding DragLeaveCommand}">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding SettingsVM.SettingsStore.UiScale}" ScaleY="{Binding SettingsVM.SettingsStore.UiScale}" />
            </Grid.LayoutTransform>
            <Grid x:Name="MainPanel">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Background="{DynamicResource BackgroundTransparentBrush}"
                    Grid.Row="0"
                    Height="45"
                    VerticalAlignment="Top"
                    x:Name="Header">
                    <Border
                        BorderBrush="{DynamicResource BorderPrimaryBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,6">
                        <Grid x:Name="HeaderContainer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    x:Name="NavContainer">
                                    <RadioButton
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Play"
                                        Height="30"
                                        IsChecked="True"
                                        Padding="10,0"
                                        Style="{StaticResource NavRadioButtonStyle}"
                                        x:Name="PlayRadio">
                                        <RadioButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox
                                                    Height="16"
                                                    Stretch="Uniform"
                                                    Width="16">
                                                    <Grid Height="16" Width="16">
                                                        <Path
                                                            Data="{StaticResource Icon.Block}"
                                                            Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                            StrokeThickness="1.33" />
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock
                                                    FontSize="14"
                                                    Margin="6,0,0,0"
                                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Play]}" />
                                            </StackPanel>
                                        </RadioButton.Content>
                                    </RadioButton>

                                    <RadioButton
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Installations"
                                        Height="30"
                                        Margin="6,0,0,0"
                                        Padding="10,0"
                                        Style="{StaticResource NavRadioButtonStyle}"
                                        x:Name="InstallationsRadio">
                                        <RadioButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox
                                                    Height="16"
                                                    Stretch="Uniform"
                                                    Width="16">
                                                    <Grid Height="16" Width="16">
                                                        <Path
                                                            Data="{StaticResource Icon.Settings}"
                                                            Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                            StrokeThickness="1.33" />
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock
                                                    FontSize="14"
                                                    Margin="6,0,0,0"
                                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Installations]}" />
                                            </StackPanel>
                                        </RadioButton.Content>
                                    </RadioButton>

                                    <RadioButton
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Skins"
                                        Height="30"
                                        Margin="6,0,0,0"
                                        Padding="10,0"
                                        Style="{StaticResource NavRadioButtonStyle}"
                                        x:Name="SkinsRadio">
                                        <RadioButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox
                                                    Height="16"
                                                    Stretch="Uniform"
                                                    Width="16">
                                                    <Grid Height="16" Width="16">
                                                        <Path
                                                            Data="{StaticResource Icon.Skin}"
                                                            Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                            StrokeThickness="1.33" />
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock
                                                    FontSize="14"
                                                    Margin="6,0,0,0"
                                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Skins]}" />
                                            </StackPanel>
                                        </RadioButton.Content>
                                    </RadioButton>
                                </StackPanel>
                                <Button
                                    Command="{Binding OpenLoginCommand}"
                                    FontSize="14"
                                    Grid.Column="2"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Margin="6,0,0,0"
                                    Tag="{StaticResource Icon.Account}"
                                    helpers:ButtonHelper.IconSize="14"
                                    x:Name="LoginButton">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">

                                            <Setter Property="Content" Value="{Binding Source={StaticResource Loc}, Path=[MainWindow.Header.LoginButton]}" />
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding LoginVM.LoginStore.IsLoggedIn}" Value="True">
                                                    <Setter Property="Content" Value="{Binding LoginVM.LoginStore.CurrentAccount.Username}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LoginVM.LoginStore.IsLoggedIn}" Value="False">
                                                    <Setter Property="Content" Value="{Binding Source={StaticResource Loc}, Path=[MainWindow.Header.LoginButton]}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" x:Name="Main">
                    <Border x:Name="FooterAndHeaderBackground">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding AppStore.CurrentBannerPath}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="0" />
                        </Border.Effect>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5, 1" StartPoint="0.5, 0">
                                    <GradientStop Color="#3D000000" Offset="0.0" />

                                    <GradientStop Color="#93000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Background="{DynamicResource BackgroundTransparentBrush}"
                            Grid.Row="1"
                            Height="47"
                            x:Name="Footer">
                            <Border
                                BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="20,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ComboBox
                                            Height="35"
                                            IsEnabled="{Binding IsEnabledInstancesComboBox}"
                                            ItemContainerStyle="{StaticResource InstanceItemContainerStyle}"
                                            ItemTemplate="{StaticResource InstanceDataTemplate}"
                                            ItemsSource="{Binding InstancesStore.Instances}"
                                            SelectedItem="{Binding InstancesStore.SelectedInstance}"
                                            Style="{StaticResource InstanceComboBox}"
                                            Width="300"
                                            helpers:ComboBoxHelper.PopupPlacement="Top" />
                                        <Button
                                            Command="{Binding LaunchCommand}"
                                            FontSize="16"
                                            Height="35"
                                            HorizontalAlignment="Center"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{Binding PlayVM.CurrentPlayButtonIcon, Converter={StaticResource StringToResourceConverter}}"
                                            Visibility="{Binding AppStore.ShowCompactPlayButton, Converter={StaticResource BoolToVis}}"
                                            Width="35"
                                            helpers:ButtonHelper.IsLoading="{Binding AppStore.IsDownloading}"
                                            x:Name="PlayButtonCompact" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button
                                            BorderThickness="{DynamicResource DefaultBorderThickness}"
                                            Command="{Binding InstallationsVM.OpenInstanceFolderCommand}"
                                            Height="35"
                                            Padding="0"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Tag="{StaticResource Icon.Folder}"
                                            Width="35"
                                            x:Name="OpenFolderButton">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource ContextMenuStyle}">
                                                    <MenuItem Command="{Binding InstallationsVM.OpenInstanceFolderCommand}" Header="{Binding Source={StaticResource Loc}, Path=[MainWindow.Footer.OpenFolder.ContextMenu.OpenInstanceFolder]}" />

                                                    <MenuItem Command="{Binding InstallationsVM.OpenModsFolderCommand}" Header="{Binding Source={StaticResource Loc}, Path=[MainWindow.Footer.OpenFolder.ContextMenu.OpenInstanceModsFolder]}" />

                                                    <Separator />
                                                    <MenuItem Command="{Binding InstallationsVM.OpenRootFolderCommand}" Header="{Binding Source={StaticResource Loc}, Path=[MainWindow.Footer.OpenFolder.ContextMenu.OpenRootMinecraftFolder]}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button
                                            BorderThickness="{DynamicResource DefaultBorderThickness}"
                                            Command="{Binding OpenSettingsCommand}"
                                            Height="35"
                                            Margin="6,0,0,0"
                                            Padding="0"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Tag="{StaticResource Icon.Settings}"
                                            Width="35"
                                            x:Name="SettingsButton" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="0" x:Name="TabsContainer">
                            <ContentControl Content="{Binding AppStore.CurrentView}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Grid
                Panel.ZIndex="999"
                Visibility="{Binding AppStore.IsOverlayVisible, Converter={StaticResource BoolToVis}}"
                x:Name="OverlayContainer">

                <Border Background="#10000000">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding CloseOverlayCommand}" MouseAction="LeftClick" />
                    </Border.InputBindings>
                </Border>

                <Grid
                    HorizontalAlignment="Center"
                    Margin="0,0,0,32"
                    RenderTransformOrigin="0.5,0.5"
                    VerticalAlignment="Center"
                    x:Name="OverlayWrapper">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" x:Name="OverlayScale" />
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource OverlayBackgroundSurfaceBrush}" CornerRadius="{DynamicResource DefaultCorner}">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="120"
                                Color="Black"
                                Opacity="1"
                                RenderingBias="Quality"
                                ShadowDepth="0" />
                        </Border.Effect>
                    </Border>

                    <ContentControl Content="{Binding AppStore.CurrentOverlayView}" IsHitTestVisible="True" />

                    <Border
                        Background="White"
                        CornerRadius="{DynamicResource DefaultCorner}"
                        IsHitTestVisible="False"
                        Opacity="0"
                        x:Name="FlashOverlay" />
                </Grid>

            </Grid>

            <!--  Notifications overlay slot  -->
            <ItemsControl
                HorizontalAlignment="Right"
                ItemsSource="{Binding Source={StaticResource Notif}, Path=Notifications}"
                Margin="0,55,20,55"
                Panel.ZIndex="9999"
                VerticalAlignment="Top">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Info}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <notifications:InfoNotify />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Success}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <notifications:SuccessNotify />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Warning}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <notifications:WarnNotify />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Error}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <notifications:ErrorNotify />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Drag & Drop Overlay  -->
            <Grid
                AllowDrop="True"
                Background="Transparent"
                Panel.ZIndex="1000"
                Visibility="{Binding AppStore.IsDragDropActive, Converter={StaticResource BoolToVis}}"
                behaviors:FileDragDropBehavior.DragEnterCommand="{Binding DragEnterCommand}"
                behaviors:FileDragDropBehavior.DragLeaveCommand="{Binding DragLeaveCommand}"
                behaviors:FileDragDropBehavior.DropCommand="{Binding DropCommand}"
                x:Name="DragDropOverlay">

                <Border Background="{DynamicResource BackgroundTransparentBrush}" Padding="10">
                    <Grid Margin="10">

                        <Border Background="{DynamicResource BackgroundSurfaceBrush}" CornerRadius="{DynamicResource SecondaryCorner}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="120"
                                    Color="Black"
                                    Opacity="1"
                                    RenderingBias="Quality"
                                    ShadowDepth="0" />
                            </Border.Effect>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox
                                    Height="40"
                                    Margin="0,0,0,10"
                                    Stretch="Uniform"
                                    Width="40">
                                    <Path
                                        Data="{StaticResource Icon.Upload}"
                                        Stroke="{DynamicResource ForegroundSecondaryBrush}"
                                        StrokeThickness="1.5" />
                                </Viewbox>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,8"
                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.DragDropOverlay.Title]}" />
                                <TextBlock
                                    FontSize="16"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    HorizontalAlignment="Center"
                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.DragDropOverlay.Subtitle]}" />
                            </StackPanel>
                        </Border>

                        <Rectangle
                            IsHitTestVisible="False"
                            RadiusX="6"
                            RadiusY="6"
                            Stroke="{DynamicResource BorderSecondaryBrush}"
                            StrokeDashArray="4 2"
                            StrokeThickness="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
