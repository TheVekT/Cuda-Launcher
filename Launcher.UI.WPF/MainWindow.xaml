<Window
    Background="{DynamicResource AppBackgroundBrush}"
    FontFamily="{DynamicResource GlobalFont}"
    FontWeight="Medium"
    Height="700"
    Margin="0"
    MinHeight="700"
    MinWidth="1100"
    Title="{Binding Source={StaticResource Loc}, Path=[MainWindow.Title]}"
    Width="1100"
    WindowStyle="SingleBorderWindow"
    d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
    mc:Ignorable="d"
    x:Class="Launcher.UI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Launcher.UI.WPF.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Launcher.UI.WPF.Helpers"
    xmlns:local="clr-namespace:Launcher.UI.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlays="clr-namespace:Launcher.UI.WPF.Resources.Overlay"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:viewModels="clr-namespace:Launcher.UI.WPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="1"
            CornerRadius="{DynamicResource DefaultCorner}"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:CustomTitleBar Grid.Row="0" />
            <Grid
                Background="{DynamicResource BackgroundTransparentBrush}"
                Grid.Row="1"
                Height="45"
                VerticalAlignment="Top"
                x:Name="Header">
                <Border
                    BorderBrush="{DynamicResource BorderPrimaryBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,6">
                    <Grid x:Name="HeaderContainer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                x:Name="LogoContainer">
                                <Image Source="/Assets/Icons/logo.png" VerticalAlignment="Center" />
                                <TextBlock
                                    FontSize="24"
                                    Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                    Margin="6,0,0,0"
                                    Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Header.LogoText]}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Margin="50,0,0,0"
                                Orientation="Horizontal"
                                x:Name="NavContainer">
                                <RadioButton
                                    Checked="NavRadio_Checked"
                                    Height="30"
                                    IsChecked="True"
                                    Padding="10,0"
                                    Style="{StaticResource NavRadioButtonStyle}"
                                    Tag="Resources/Pages/Play.xaml"
                                    x:Name="PlayRadio">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox
                                                Height="16"
                                                Stretch="Uniform"
                                                Width="16">
                                                <Grid Height="16" Width="16">
                                                    <Path
                                                        Data="{StaticResource Icon.Block}"
                                                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                        StrokeThickness="1.33" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock
                                                FontSize="14"
                                                Margin="6,0,0,0"
                                                Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Play]}" />
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>

                                <RadioButton
                                    Checked="NavRadio_Checked"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Padding="10,0"
                                    Style="{StaticResource NavRadioButtonStyle}"
                                    Tag="Resources/Pages/Installations.xaml"
                                    x:Name="InstallationsRadio">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox
                                                Height="16"
                                                Stretch="Uniform"
                                                Width="16">
                                                <Grid Height="16" Width="16">
                                                    <Path
                                                        Data="{StaticResource Icon.Settings}"
                                                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                        StrokeThickness="1.33" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock
                                                FontSize="14"
                                                Margin="6,0,0,0"
                                                Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Installations]}" />
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>

                                <RadioButton
                                    Checked="NavRadio_Checked"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Padding="10,0"
                                    Style="{StaticResource NavRadioButtonStyle}"
                                    Tag="Resources/Pages/Skins.xaml"
                                    x:Name="SkinsRadio">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox
                                                Height="16"
                                                Stretch="Uniform"
                                                Width="16">
                                                <Grid Height="16" Width="16">
                                                    <Path
                                                        Data="{StaticResource Icon.Skin}"
                                                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                        StrokeThickness="1.33" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock
                                                FontSize="14"
                                                Margin="6,0,0,0"
                                                Text="{Binding Source={StaticResource Loc}, Path=[MainWindow.Navigation.Skins]}" />
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>
                            </StackPanel>
                            <Button
                                Command="{Binding OpenLoginCommand}"
                                Content="{Binding Source={StaticResource Loc}, Path=[MainWindow.Header.LoginButton]}"
                                FontSize="14"
                                Grid.Column="2"
                                Height="30"
                                HorizontalAlignment="Right"
                                Margin="6,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="{StaticResource Icon.Account}"
                                helpers:ButtonHelper.IconSize="14"
                                x:Name="LoginButton" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" x:Name="Main">
                <Border x:Name="FooterAndHeaderBackground">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/Images/banner-default.jpg" Stretch="UniformToFill" />

                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="4" />
                    </Border.Effect>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5, 1" StartPoint="0.5, 0">
                                <GradientStop Color="#4D000000" Offset="0.0" />

                                <GradientStop Color="#B3000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        Background="{DynamicResource BackgroundTransparentBrush}"
                        Grid.Row="1"
                        Height="47"
                        x:Name="Footer">
                        <Border
                            BorderBrush="{DynamicResource BorderPrimaryBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ComboBox
                                        Height="35"
                                        ItemContainerStyle="{StaticResource ImageComboBoxItemStyle}"
                                        ItemTemplate="{StaticResource ImageComboBoxItemTemplate}"
                                        SelectedIndex="0"
                                        Style="{StaticResource VersionsComboBox}"
                                        Width="300"
                                        helpers:ComboBoxHelper.PopupPlacement="Top">
                                        <ComboBoxItem Tag="/Assets/Icons/logo.png">Latest Release</ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        FontSize="16"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{StaticResource Icon.Play}"
                                        Visibility="Collapsed"
                                        Width="35"
                                        x:Name="PlayButtonCompact" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button
                                        BorderThickness="{DynamicResource DefaultBorderThickness}"
                                        Height="35"
                                        Padding="0"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Tag="{StaticResource Icon.Folder}"
                                        Width="35"
                                        x:Name="OpenFolderButton" />
                                    <Button
                                        BorderThickness="{DynamicResource DefaultBorderThickness}"
                                        Command="{Binding OpenSettingsCommand}"
                                        Height="35"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Tag="{StaticResource Icon.Settings}"
                                        Width="35"
                                        x:Name="SettingsButton" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="0" x:Name="TabsContainer">
                        <Frame
                            Navigated="MainFrame_Navigated"
                            NavigationUIVisibility="Hidden"
                            Panel.ZIndex="10"
                            Source="Resources/Pages/Play.xaml"
                            x:Name="MainFrame" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid
            Panel.ZIndex="999"
            Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVis}}"
            x:Name="OverlayContainer">

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding CloseOverlayCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
            </Border>

            <ContentControl
                Content="{Binding CurrentOverlayView}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </Grid>
    </Grid>
</Window>
