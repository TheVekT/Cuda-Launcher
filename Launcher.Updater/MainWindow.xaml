<Window
    Background="Transparent"
    FontFamily="{DynamicResource GlobalFont}"
    Height="160"
    Icon="icon.ico"
    ResizeMode="CanMinimize"
    Title="Cuda Launcher — Updater"
    Width="460"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    mc:Ignorable="d"
    x:Class="Launcher.Updater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:components="clr-namespace:Launcher.Updater.Resources.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:viewModels="clr-namespace:Launcher.Updater.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="8"
            GlassFrameThickness="1"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border
        Background="{DynamicResource AppBackgroundBrush}"
        BorderBrush="{DynamicResource BorderPrimaryBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="8"
        x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Custom Title Bar (no maximize button)  -->
            <components:CustomTitleBar Grid.Row="0" />

            <!--  Main Updater Interface (Status, Percentage, Progress Bar)  -->
            <Grid Grid.Row="1" Margin="24,12,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Status Header: Icon Badge + Text  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Height="38"
                        Source="pack://application:,,,/icon.ico"
                        Width="38" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundPrimaryBrush}"
                            Text="{Binding StatusTitle}"
                            x:Name="TitleStatusText" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource ForegroundSecondaryBrush}"
                            Margin="0,3,0,0"
                            Text="{Binding StatusDetail}"
                            TextTrimming="CharacterEllipsis"
                            x:Name="DetailStatusText" />
                    </StackPanel>
                </Grid>

                <!--  Metrics: Speed / Details and Percentage  -->
                <Grid Grid.Row="2" Margin="0,16,0,6">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        HorizontalAlignment="Left"
                        Text="{Binding SpeedInfo}"
                        x:Name="SpeedText" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundPrimaryBrush}"
                        HorizontalAlignment="Right"
                        Text="{Binding PercentText}"
                        x:Name="PercentText" />
                </Grid>

                <!--  Modern Progress Bar  -->
                <ProgressBar
                    Grid.Row="3"
                    Height="8"
                    IsIndeterminate="{Binding IsIndeterminate}"
                    Maximum="100"
                    Style="{DynamicResource ModernProgressBarStyle}"
                    Value="{Binding Progress}"
                    x:Name="UpdateProgressBar" />
            </Grid>
        </Grid>
    </Border>
</Window>
